    "    \"tensorflow\": \"tensorflow\",\n",
    "    \"tensorflow_model_optimization\": \"tensorflow-model-optimization\",\n",
    "}\n",
    "missing = [f\"{mod} (pip package: {pkg})\" for mod, pkg in required_modules.items() if importlib.util.find_spec(mod) is None]\n",
