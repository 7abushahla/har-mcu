    "_v2_checks = [\n",
    "    {\n",
    "        \"check\": \"Baseline accuracy (target 0.9824, tol ±0.02)\",\n",
    "        \"target\": 0.9824,\n",
    "        \"achieved\": round(float_accuracy_v2, 4),\n",
