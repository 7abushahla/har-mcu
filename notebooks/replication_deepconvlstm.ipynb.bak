    "        \"delta\": round(model_size_v2_kb - 136.51, 2),\n",
    "        \"status\": \"PASS\" if abs(model_size_v2_kb - 136.51) <= 60.0 else \"WARN\",\n",
    "    },\n",
    "]\n",
    "display(pd.DataFrame(_v2_checks))\n"
   ]
